//
// TargetPhase: EmitCapp2Plist
//
// Stub. Runs once per target, concurrently with every other target's
// worker. Will emit the resolved object table as CAPP2PLIST text to
// ctx.target.cib_path, computed for this target in ResolveProjectPaths.
//
// **
import "go:fmt"

pub struct EmitCapp2PlistResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_emit_capp2plist(ctx: Ref<TargetContext>) -> Result<EmitCapp2PlistResult, error> {
  fmt.Println(f"○  emit-capp2plist: stub — {ctx.target.cib_path}")
  Ok(EmitCapp2PlistResult { diags: [] })
}
