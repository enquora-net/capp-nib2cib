//
// Phase 6: EmitCapp2Plist
//
// Stub. Will emit the resolved object table as CAPP2PLIST text, one file per
// target, to the cib_path computed for it in phase 1.
//
// **
import "go:fmt"

pub struct EmitCapp2PlistResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_emit_capp2plist(ctx: Ref<PipelineContext>) -> Result<EmitCapp2PlistResult, error> {
  let n = ctx.paths.map_or(0, |r| r.targets.length())
  fmt.Println(f"○  emit-capp2plist: stub — {n} target(s)")
  Ok(EmitCapp2PlistResult { diags: [] })
}
