//
// TargetPhase: BuildArchive
//
// Consumes the FlattenedObject table and builds the 280NPLIST $objects
// array: assigning CP$UID indices, interning strings, and generating
// class descriptors in a single unified pass.
//
// **
import "go:fmt"

pub enum ArchiveObject {
  Null,
  String(string),
  Class { name: string, classes: Slice<string> },
  Instance { class_uid: int, members: Slice<ArchiveMember> },
}

pub struct ArchiveMember {
  pub key: string,
  pub uid: int,
}

pub struct ObjectUid {
  pub id: string,
  pub uid: int,
}

pub struct BuildArchiveResult {
  pub diags: Slice<Diagnostic>,
  pub root_uid: int,
  pub objects: Slice<ArchiveObject>,
}

fn find_string_uid(objects: Slice<ArchiveObject>, s: string) -> Option<int> {
  let mut i = 0
  for obj in objects {
    if let ArchiveObject.String(existing) = obj {
      if existing == s { return Some(i) }
    }
    i += 1
  }
  None
}

fn find_class_uid(objects: Slice<ArchiveObject>, target_name: string) -> Option<int> {
  let mut i = 0
  for obj in objects {
    if let ArchiveObject.Class { name, .. } = obj {
      if name == target_name { return Some(i) }
    }
    i += 1
  }
  None
}

fn find_object_uid(uids: Slice<ObjectUid>, id: string) -> Option<int> {
  for entry in uids {
    if entry.id == id { return Some(entry.uid) }
  }
  None
}

struct ArchiveBuilder {
  objects: Slice<ArchiveObject>,
  object_uids: Slice<ObjectUid>,
}

impl ArchiveBuilder {
  fn add_object(self: Ref<ArchiveBuilder>, obj: ArchiveObject) -> int {
    let uid = self.*.objects.length()
    self.*.objects = self.*.objects.append(obj)
    uid
  }

  fn intern_string(self: Ref<ArchiveBuilder>, s: string) -> int {
    if let Some(uid) = find_string_uid(self.*.objects, s) { return uid }
    self.add_object(ArchiveObject.String(s))
  }

  fn intern_class(self: Ref<ArchiveBuilder>, name: string) -> int {
    if let Some(uid) = find_class_uid(self.*.objects, name) { return uid }
    let classes = [name]
    self.add_object(ArchiveObject.Class { name, classes })
  }

  fn serialize_value(self: Ref<ArchiveBuilder>, node: Ref<XibNode>) -> int {
    if node.attrs.is_empty() && node.children.is_empty() {
      return self.intern_string(node.text)
    }

    let class_uid = self.intern_class(node.tag)
    let mut members: Slice<ArchiveMember> = []

    for a in node.attrs {
      let val_uid = self.intern_string(a.value)
      members = members.append(ArchiveMember { key: a.key, uid: val_uid })
    }

    if node.text != "" {
      let val_uid = self.intern_string(node.text)
      members = members.append(ArchiveMember { key: "text", uid: val_uid })
    }

    self.add_object(ArchiveObject.Instance { class_uid, members })
  }
}

pub fn run_build_archive(ctx: Ref<TargetContext>) -> Result<BuildArchiveResult, error> {
  let Some(flattened) = ctx.flattened else {
    return Ok(
      BuildArchiveResult {
        diags: [diag_error("build archive", "FlattenObjectGraph has not run")],
        root_uid: 0,
        objects: [ArchiveObject.Null],
      },
    )
  }

  let mut builder = ArchiveBuilder {
    objects: [ArchiveObject.Null],
    object_uids: [],
  }

  // Pass 1: Pre-allocate UIDs for all top-level FlattenedObjects.
  for obj in flattened.objects {
    let uid = builder.objects.length()
    builder.object_uids = builder.object_uids.append(
      ObjectUid { id: obj.id, uid },
    )
    builder.objects = builder.objects.append(ArchiveObject.Null)
  }

  // Pass 2: Populate the instances, interning strings and classes.
  let mut idx = 1
  // Start at 1 to skip the $null sentinel at index 0
  for obj in flattened.objects {
    let class_uid = (&builder).intern_class(obj.tag)
    let mut members: Slice<ArchiveMember> = []

    for m in obj.members {
      let val_uid = if let Some(id) = m.target_id {
        find_object_uid(builder.object_uids, id).unwrap_or(0)
      } else if let Some(v) = m.value {
        (&builder).serialize_value(&v)
      } else {
        0
      }
      members = members.append(ArchiveMember { key: m.key, uid: val_uid })
    }

    builder.objects[idx] = ArchiveObject.Instance { class_uid, members }
    idx += 1
  }

  // The root object is the first one processed (the <document> element)
  let root_uid = 1

  if !ctx.config.quiet {
    fmt.Println(
      f"\u{2713}  build-archive: {ctx.target.xib_path} ({builder.objects.length()} archive objects)",
    )
  }

  Ok(BuildArchiveResult { diags: [], root_uid, objects: builder.objects })
}
