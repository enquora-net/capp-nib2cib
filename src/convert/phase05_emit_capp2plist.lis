import "go:fmt"

pub struct EmitCapp2PlistResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_emit_capp2plist(ctx: Ref<PipelineContext>) -> Result<EmitCapp2PlistResult, error> {
  fmt.Println(f"○  emit-capp2plist: stub — {ctx.config.output}")
  Ok(EmitCapp2PlistResult { diags: [] })
}
