//
// TargetPhase: ResolveUidReferences
//
// Stub. Runs once per target, concurrently with every other target's
// worker. Will resolve XIB string object IDs to integer CP$UID references
// against this target's own interned string pool from InternStrings.
//
// **
import "go:fmt"

pub struct ResolveUidReferencesResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_resolve_uid_references(ctx: Ref<TargetContext>) -> Result<ResolveUidReferencesResult, error> {
  fmt.Println(f"○  resolve-uid-references: stub — {ctx.target.xib_path}")
  Ok(ResolveUidReferencesResult { diags: [] })
}
