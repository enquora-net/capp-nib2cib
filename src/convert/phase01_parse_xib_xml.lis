//
// Phase 1: ParseXibXml
//
// Stub. Will parse the XIB XML tree at ctx.config.input into a typed CST,
// with zero semantic knowledge of AppKit (see README.md — blind structural
// transpiler, not the legacy semantic interpreter).
//
// **
import "go:fmt"

pub struct ParseXibXmlResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_parse_xib_xml(ctx: Ref<PipelineContext>) -> Result<ParseXibXmlResult, error> {
  fmt.Println(f"○  parse-xib-xml: stub — {ctx.config.input}")
  Ok(ParseXibXmlResult { diags: [] })
}
