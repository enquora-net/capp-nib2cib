//
// TargetPhase: FlattenObjectGraph
//
// Stub. Runs once per target, concurrently with every other target's
// worker. Will walk the parsed XIB tree from the ParseXibXml phase and
// flatten it into a linear object table, mirroring the XIB structure
// one-to-one.
//
// **
import "go:fmt"

pub struct FlattenObjectGraphResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_flatten_object_graph(ctx: Ref<TargetContext>) -> Result<FlattenObjectGraphResult, error> {
  fmt.Println(f"○  flatten-object-graph: stub — {ctx.target.xib_path}")
  Ok(FlattenObjectGraphResult { diags: [] })
}
