//
// TargetPhase: FlattenObjectGraph
//
// Uses XPath queries to declaratively extract objects and members,
// replacing the fragile imperative recursive walker. This guarantees
// mathematically exhaustive evaluation of the XML topology.
//
// **
import "go:github.com/antchfx/xmlquery"

fn reference_attrs() -> Slice<string> {
  ["target", "destination"]
}

fn is_reference_attr(name: string) -> bool {
  for r in reference_attrs() {
    if r == name { return true }
  }
  false
}

pub enum FlatValue {
  Str(string),
  Node(Ref<xmlquery.Node>),
}

pub struct FlatMember {
  pub key: string,
  pub target_id: Option<string>,
  pub value: Option<FlatValue>,
}

pub struct FlattenedObject {
  pub id: string,
  pub tag: string,
  pub key: Option<string>,
  pub members: Slice<FlatMember>,
}

pub struct FlattenObjectGraphResult {
  pub diags: Slice<Diagnostic>,
  pub objects: Slice<FlattenedObject>,
}

// find_nearest_id_descendants recursively searches a subtree for
// id-bearing nodes, but stops descending down a branch as soon as it
// finds one. This ensures we respect object containment boundaries.
fn find_nearest_id_descendants(node: Ref<xmlquery.Node>) -> Slice<Ref<xmlquery.Node>> {
  let mut found: Slice<Ref<xmlquery.Node>> = []
  let children = xmlquery.Find(node, "child::*")
  for child in children {
    let child_id = child.SelectAttr("id")
    if child_id != "" {
      // Found an id-bearing node. Stop descending this branch.
      found = found.append(child)
    } else {
      // No id here. Keep descending.
      let deeper = find_nearest_id_descendants(child)
      for d in deeper {
        found = found.append(d)
      }
    }
  }
  found
}

// extract_members uses XPath to find attributes and child elements,
// correctly classifying them as references, arrays, or plain values.
fn extract_members(
  node: Ref<xmlquery.Node>,
  table: Ref<Slice<FlattenedObject>>,
  next_array_id: Ref<int>,
) -> Slice<FlatMember> {
  let mut members: Slice<FlatMember> = []

  // 1. Attributes (excluding id and key)
  for attr in node.Attr {
    let name = attr.Name.Local
    if name == "id" || name == "key" { continue }

    if is_reference_attr(name) {
      members = members.append(
        FlatMember { key: name, target_id: Some(attr.Value), value: None },
      )
    } else {
      members = members.append(
        FlatMember {
          key: name,
          target_id: None,
          value: Some(FlatValue.Str(attr.Value)),
        },
      )
    }
  }

  // 2. Child Elements
  let children = xmlquery.Find(node, "child::*")
  for child in children {
    let wrapper_key_attr = child.SelectAttr("key")
    let key = if wrapper_key_attr == "" { child.Data } else { wrapper_key_attr }

    let child_id_attr = child.SelectAttr("id")
    if child_id_attr != "" {
      // Direct id-bearing child: containment reference
      members = members.append(
        FlatMember { key, target_id: Some(child_id_attr), value: None },
      )
    } else {
      // Check for nearest id-bearing descendants to respect boundaries
      let descendants = find_nearest_id_descendants(child)
      if descendants.is_empty() {
        // No id-bearing descendants: plain value
        members = members.append(
          FlatMember {
            key,
            target_id: None,
            value: Some(FlatValue.Node(child)),
          },
        )
      } else {
        // Has id-bearing descendants: synthesize an array wrapper
        let array_id = f"__array_{next_array_id.*}"
        next_array_id.* += 1

        let mut array_members: Slice<FlatMember> = []
        for desc in descendants {
          let desc_id = desc.SelectAttr("id")
          array_members = array_members.append(
            FlatMember { key: "", target_id: Some(desc_id), value: None },
          )
        }

        table.* = table.*.append(
          FlattenedObject {
            id: array_id,
            tag: "array",
            key: None,
            members: array_members,
          },
        )

        members = members.append(
          FlatMember { key, target_id: Some(array_id), value: None },
        )
      }
    }
  }

  members
}

pub fn run_flatten_object_graph(ctx: Ref<TargetContext>) -> Result<FlattenObjectGraphResult, error> {
  let Some(parsed) = ctx.parsed else {
    return Ok(
      FlattenObjectGraphResult {
        diags: [diag_error("flatten object graph", "ParseXibXml has not run")],
        objects: [],
      },
    )
  }

  let Some(tree) = parsed.tree else {
    return Ok(
      FlattenObjectGraphResult {
        diags: [diag_error("flatten object graph", "no parsed tree available")],
        objects: [],
      },
    )
  }

  let mut table: Slice<FlattenedObject> = []
  let mut next_array_id = 1

  // 1. Extract the root <document> element
  let doc_members = extract_members(tree, &table, &next_array_id)
  table = table.append(
    FlattenedObject {
      id: "document",
      tag: tree.Data,
      key: None,
      members: doc_members,
    },
  )

  // 2. Extract all id-bearing objects anywhere in the document
  let id_nodes = xmlquery.Find(tree, "descendant::*[@id]")
  for node in id_nodes {
    let id = node.SelectAttr("id")
    let key_attr = node.SelectAttr("key")
    let key = if key_attr == "" { None } else { Some(key_attr) }

    let members = extract_members(node, &table, &next_array_id)
    table = table.append(FlattenedObject { id, tag: node.Data, key, members })
  }

  if table.is_empty() {
    if ctx.config.verbose >= 1 {
      ctx.messages = ctx.messages.append(
        f"\u{2715}  flatten-object-graph: {ctx.target.xib_path}: no id-bearing objects found",
      )
    }
    return Ok(
      FlattenObjectGraphResult {
        diags: [
          diag_error("flatten object graph", "no id-bearing objects found"),
        ],
        objects: [],
      },
    )
  }

  if ctx.config.verbose >= 1 {
    ctx.messages = ctx.messages.append(
      f"\u{2713}  flatten-object-graph: {ctx.target.xib_path} ({table.length()} objects)",
    )
  }
  Ok(FlattenObjectGraphResult { diags: [], objects: table })
}
