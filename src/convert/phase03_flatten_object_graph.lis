//
// TargetPhase: FlattenObjectGraph
//
// Flattens the XibNode tree from ParseXibXml into a flat table of
// FlattenedObject rows, one per id-bearing element anywhere in the tree,
// regardless of nesting depth. Per README.md's architecture: this tool has
// zero semantic knowledge of AppKit — it never reads a tag name or an
// attribute's meaning to decide anything.
//
// Every attribute and every child of an id-bearing object becomes exactly
// one FlatMember, with no separate unguarded bucket alongside it. A member
// is one of two things:
//   - a reference (target_id: Some) to another row in the table
//   - an embedded plain value (value: Some) — data, not identity
//
// Two, and only two, structural signals decide which:
//   - id presence: a child ELEMENT that carries its own id is a reference
//     to that element's own row (a containment reference).
//   - a small fixed set of ATTRIBUTE names — target, destination — whose
//     value equals another element's id anywhere in the document (a
//     cross-reference, e.g. <action target="-2" .../>). This set comes
//     from the XIB connection grammar itself (<outlet>/<action> elements),
//     not from any AppKit class knowledge.
//
// Per v2.0 Schema: Containment references use a single local key (the
// child's `key` attribute or the wrapper element's tag name). Deep path
// accumulation is not required. The root <document> element is forcibly
// registered as the root object of the flat table.
//
// **
import "go:fmt"

fn reference_attrs() -> Slice<string> {
  ["target", "destination"]
}

fn is_reference_attr(name: string) -> bool {
  for r in reference_attrs() {
    if r == name { return true }
  }
  false
}

pub struct FlatMember {
  pub key: string,
  pub target_id: Option<string>,
  pub value: Option<XibNode>,
}

pub struct FlattenedObject {
  pub id: string,
  pub tag: string,
  pub key: Option<string>,
  pub members: Slice<FlatMember>,
}

pub struct FlattenObjectGraphResult {
  pub diags: Slice<Diagnostic>,
  pub objects: Slice<FlattenedObject>,
}

fn find_attr(node: Ref<XibNode>, key: string) -> Option<string> {
  for a in node.attrs {
    if a.key == key { return Some(a.value) }
  }
  None
}

fn attr_members(node: Ref<XibNode>) -> Slice<FlatMember> {
  let mut members: Slice<FlatMember> = []
  for a in node.attrs {
    if a.key == "id" || a.key == "key" { continue }
    if is_reference_attr(a.key) {
      members = members.append(
        FlatMember { key: a.key, target_id: Some(a.value), value: None },
      )
    } else {
      members = members.append(
        FlatMember {
          key: a.key,
          target_id: None,
          value: Some(
            XibNode { tag: a.key, attrs: [], children: [], text: a.value },
          ),
        },
      )
    }
  }
  members
}

fn flatten_into(
  node: Ref<XibNode>,
  table: Ref<Slice<FlattenedObject>>,
  next_array_id: Ref<int>,
) {
  let id = find_attr(node, "id").unwrap_or("")
  let key = find_attr(node, "key")
  let mut members = attr_members(node)
  let child_members = walk_children(&node.children, table, next_array_id)
  for m in child_members {
    members = members.append(m)
  }
  table.* = table.*.append(FlattenedObject { id, tag: node.tag, key, members })
}

fn walk_children(
  children: Ref<Slice<XibNode>>,
  table: Ref<Slice<FlattenedObject>>,
  next_array_id: Ref<int>,
) -> Slice<FlatMember> {
  let mut members: Slice<FlatMember> = []
  for child in children.* {
    match find_attr(&child, "id") {
      Some(child_id) => {
        let key = find_attr(&child, "key").unwrap_or(child.tag)
        members = members.append(
          FlatMember { key, target_id: Some(child_id), value: None },
        )
        flatten_into(&child, table, next_array_id)
      },
      None => {
        let wrapper_key = find_attr(&child, "key").unwrap_or(child.tag)

        // Check if this wrapper contains id-bearing children (i.e., it's an array)
        let mut has_id_children = false
        for inner in child.children {
          if find_attr(&inner, "id").is_some() {
            has_id_children = true
            break
          }
        }

        if has_id_children {
          // Synthesize an array object to maintain valid dictionary keys
          let array_id = f"__array_{next_array_id.*}"
          next_array_id.* += 1

          let array_members = walk_children(
            &child.children,
            table,
            next_array_id,
          )

          table.* = table.*.append(
            FlattenedObject {
              id: array_id,
              tag: "array",
              key: None,
              members: array_members,
            },
          )

          members = members.append(
            FlatMember {
              key: wrapper_key,
              target_id: Some(array_id),
              value: None,
            },
          )
        } else {
          // It's a plain value.
          members = members.append(
            FlatMember { key: wrapper_key, target_id: None, value: Some(child) },
          )
        }
      },
    }
  }
  members
}

pub fn run_flatten_object_graph(ctx: Ref<TargetContext>) -> Result<FlattenObjectGraphResult, error> {
  let Some(parsed) = ctx.parsed else {
    return Ok(
      FlattenObjectGraphResult {
        diags: [diag_error("flatten object graph", "ParseXibXml has not run")],
        objects: [],
      },
    )
  }
  let Some(tree) = parsed.tree else {
    return Ok(
      FlattenObjectGraphResult {
        diags: [diag_error("flatten object graph", "no parsed tree available")],
        objects: [],
      },
    )
  }

  let mut table: Slice<FlattenedObject> = []
  let mut next_array_id = 1

  let doc_members = walk_children(&tree.children, &table, &next_array_id)
  table = table.append(
    FlattenedObject {
      id: "document",
      tag: tree.tag,
      key: None,
      members: doc_members,
    },
  )

  if table.is_empty() {
    if !ctx.config.quiet {
      fmt.Println(
        f"\u{2715}  flatten-object-graph: {ctx.target.xib_path}: no id-bearing objects found",
      )
    }
    return Ok(
      FlattenObjectGraphResult {
        diags: [
          diag_error("flatten object graph", "no id-bearing objects found"),
        ],
        objects: [],
      },
    )
  }

  if !ctx.config.quiet {
    fmt.Println(
      f"\u{2713}  flatten-object-graph: {ctx.target.xib_path} ({table.length()} objects)",
    )
  }
  Ok(FlattenObjectGraphResult { diags: [], objects: table })
}
