//
// TargetPhase: ParseXibXml
//
// Stub. Runs once per target, concurrently with every other target's
// worker (see pipeline.lis's run_target). Will parse the XIB XML tree at
// ctx.target.xib_path into a typed CST, with zero semantic knowledge of
// AppKit (see README.md — blind structural transpiler, not the legacy
// semantic interpreter).
//
// Output here is per-target and will interleave arbitrarily with every
// other target's output — expected under concurrent execution, and left
// unrefined for now.
//
// **
import "go:fmt"

pub struct ParseXibXmlResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_parse_xib_xml(ctx: Ref<TargetContext>) -> Result<ParseXibXmlResult, error> {
  fmt.Println(f"○  parse-xib-xml: stub — {ctx.target.xib_path}")
  Ok(ParseXibXmlResult { diags: [] })
}
