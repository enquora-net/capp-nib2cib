//
// TargetPhase: ParseXibXml
//
// Parses the XIB XML using xmlquery, which provides a DOM tree
// with native XPath support, eliminating the need for a hand-written
// recursive tree walker in later phases.
//
// **
import "go:github.com/antchfx/xmlquery"
import "go:os"

pub struct ParseXibXmlResult {
  pub diags: Slice<Diagnostic>,
  pub tree: Option<Ref<xmlquery.Node>>,
}

pub fn run_parse_xib_xml(ctx: Ref<TargetContext>) -> Result<ParseXibXmlResult, error> {
  let f = os.Open(ctx.target.xib_path)?
  defer f.Close()

  // xmlquery.Parse returns a document node. The root element is the first child.
  let doc = xmlquery.Parse(f)?
  let root = doc.FirstChild

  if root.is_none() {
    return Ok(
      ParseXibXmlResult {
        diags: [diag_error("parse XIB XML", "no root element found")],
        tree: None,
      },
    )
  }

  if !ctx.config.quiet {
    fmt.Println(f"✓  parse-xib-xml: {ctx.target.xib_path}")
  }

  Ok(ParseXibXmlResult { diags: [], tree: root })
}
