//
// TargetPhase: InternStrings
//
// Stub. Runs once per target, concurrently with every other target's
// worker. Will intern the flattened object table's string values into a
// deduplicated string pool ahead of UID resolution. The pool is scoped to
// this one target's CIB, not shared across the batch — targets have no
// shared state anywhere in this pipeline.
//
// **
import "go:fmt"

pub struct InternStringsResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_intern_strings(ctx: Ref<TargetContext>) -> Result<InternStringsResult, error> {
  fmt.Println(f"○  intern-strings: stub — {ctx.target.xib_path}")
  Ok(InternStringsResult { diags: [] })
}
