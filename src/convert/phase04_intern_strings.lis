import "go:fmt"

pub struct InternStringsResult {
  pub diags: Slice<Diagnostic>,
}

pub fn run_intern_strings(_ctx: Ref<PipelineContext>) -> Result<InternStringsResult, error> {
  fmt.Println("○  intern-strings: stub")
  Ok(InternStringsResult { diags: [] })
}
