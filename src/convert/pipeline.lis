//
// Phase pipeline declaration and orchestration.
//
// Two different kinds of "phase" live in this file, and they are not
// treated as one enum:
//
// - ResolveProjectPaths (phase01_resolve_project_paths.lis) is a single
//   sequential setup step. It runs once, produces the target list, and has
//   no per-file concurrency to offer — root-finding depends on nothing
//   about individual files, and every target's CIB path depends on the
//   single root it finds. It is a plain function call, not an enum variant.
//
// - TargetPhase (phase02_parse_xib_xml.lis through
//   phase06_emit_capp2plist.lis) are the five per-file phases. Every XIB is
//   independent of every other XIB through the entire pipeline — nothing
//   about parsing, flattening, interning, resolving, or emitting one file
//   depends on any other file. TargetPhase is #[iterate]d once per target,
//   inside its own worker (run_target), running concurrently with every
//   other target's worker. There is no cross-target synchronization at any
//   phase boundary: an earlier design gated all files on every phase
//   together (see git history) and was rejected as needless coupling
//   between files that share nothing.
//
// Diagnostic infrastructure lives in diagnostics.lis.
//
// TargetPhase implementations are still bare stubs, pending the XIB XML
// parser, object graph flattener, string interner, UID resolver, and
// CAPP2PLIST emitter. ResolveProjectPaths is implemented and has been
// manually verified against real project trees (single file, 1 target;
// ~/Developer/Cappuccino/Fieldwork, 126 targets).
//
// **
import "go:strings"

// ---------------------------------------------------------------------------
// TargetPhase
// ---------------------------------------------------------------------------

// The compiler confirms that each variant has an implementation and that it
// runs in the correct order via the execution machinery below. Declaration
// order is the authoritative per-target execution order; #[iterate]
// synthesises variants() from it. This order applies within one target's
// worker only — it says nothing about the order targets themselves run in,
// since targets run concurrently with no ordering guarantee between them.
#[iterate]
pub enum TargetPhase {
  ParseXibXml,
  FlattenObjectGraph,
  InternStrings,
  ResolveUidReferences,
  EmitCapp2Plist,
}

// Adding a variant to TargetPhase without a corresponding arm here is a
// compile error — the binding between declaration and execution.
impl TargetPhase {
  fn run(self, ctx: Ref<TargetContext>) -> Result<(), error> {
    match self {
      ParseXibXml => {
        ctx.parsed = Some(run_parse_xib_xml(ctx)?)
        Ok(())
      },
      FlattenObjectGraph => {
        ctx.flattened = Some(run_flatten_object_graph(ctx)?)
        Ok(())
      },
      InternStrings => {
        ctx.interned = Some(run_intern_strings(ctx)?)
        Ok(())
      },
      ResolveUidReferences => {
        ctx.resolved = Some(run_resolve_uid_references(ctx)?)
        Ok(())
      },
      EmitCapp2Plist => {
        ctx.emitted = Some(run_emit_capp2plist(ctx)?)
        Ok(())
      },
    }
  }
}

fn target_phase_name(phase: TargetPhase) -> string {
  match phase {
    ParseXibXml => "parse XIB XML",
    FlattenObjectGraph => "flatten object graph",
    InternStrings => "intern strings",
    ResolveUidReferences => "resolve UID references",
    EmitCapp2Plist => "emit CAPP2PLIST",
  }
}

// ---------------------------------------------------------------------------
// ConvertConfig / ConvertResult
// ---------------------------------------------------------------------------

// input is empty, a single .xib path, or a directory. ResolveProjectPaths
// is the only place that interprets it and the only place a CIB output path
// is computed — output is never taken from the command line. See
// phase01_resolve_project_paths.lis.
pub struct ConvertConfig {
  pub input: string,
  pub default_theme: string,
  pub themes: Slice<string>,
  pub config: string,
  pub frameworks: Slice<string>,
  pub verbose: int,
  pub quiet: bool,
}

pub struct ConvertResult {
  pub ok: bool,
  pub message: string,
  pub diags: Slice<Diagnostic>,
}

// ---------------------------------------------------------------------------
// Per-target context and result
// ---------------------------------------------------------------------------

// One TargetContext per file, owned entirely by that file's worker. Nothing
// here is shared with any other target's context — this is what makes
// concurrent, unsynchronized execution across targets sound.
pub struct TargetContext {
  pub target: ConvertTarget,
  pub config: ConvertConfig,
  pub parsed: Option<ParseXibXmlResult>,
  pub flattened: Option<FlattenObjectGraphResult>,
  pub interned: Option<InternStringsResult>,
  pub resolved: Option<ResolveUidReferencesResult>,
  pub emitted: Option<EmitCapp2PlistResult>,
}

fn target_phase_diags(phase: TargetPhase, ctx: Ref<TargetContext>) -> Slice<Diagnostic> {
  match phase {
    ParseXibXml => ctx.parsed.map_or([], |r| r.diags),
    FlattenObjectGraph => ctx.flattened.map_or([], |r| r.diags),
    InternStrings => ctx.interned.map_or([], |r| r.diags),
    ResolveUidReferences => ctx.resolved.map_or([], |r| r.diags),
    EmitCapp2Plist => ctx.emitted.map_or([], |r| r.diags),
  }
}

fn has_error(diags: Slice<Diagnostic>) -> bool {
  for d in diags {
    if d.level == DiagLevel.Error { return true }
  }
  false
}

fn error_count(diags: Slice<Diagnostic>) -> int {
  let mut n = 0
  for d in diags {
    if d.level == DiagLevel.Error { n += 1 }
  }
  n
}

pub struct TargetResult {
  pub target: ConvertTarget,
  pub ok: bool,
  pub message: string,
  pub diags: Slice<Diagnostic>,
}

// run_target runs every TargetPhase for one file, start to finish, halting
// on the first phase that reports an Error — for THIS target only. Another
// target's worker halting has no effect here, and this worker halting has
// no effect on any other target's worker.
//
// The config field is built as an inline ConvertConfig literal (cloning its
// Slice fields) rather than moved from the cfg parameter directly, for the
// same reason convert() below does this: ctx is a mut binding, and
// Lisette's aliasing protection flags a Slice-bearing sibling binding that
// could be implicitly mutated through it.
fn run_target(target: ConvertTarget, cfg: ConvertConfig) -> TargetResult {
  let mut ctx = TargetContext {
    target,
    config: ConvertConfig {
      input: cfg.input,
      default_theme: cfg.default_theme,
      themes: cfg.themes.clone(),
      config: cfg.config,
      frameworks: cfg.frameworks.clone(),
      verbose: cfg.verbose,
      quiet: cfg.quiet,
    },
    ..,
  }

  for phase in TargetPhase.variants() {
    if let Err(e) = phase.run(&ctx) {
      return TargetResult {
        target: ctx.target,
        ok: false,
        message: f"{ctx.target.xib_path}: error in {target_phase_name(phase)}: {e}",
        diags: [],
      }
    }
    let diags = target_phase_diags(phase, &ctx)
    if has_error(diags) {
      let n = error_count(diags)
      return TargetResult {
        target: ctx.target,
        ok: false,
        message: f"{ctx.target.xib_path}: halted, {n} error(s) in {target_phase_name(phase)}",
        diags,
      }
    }
  }

  TargetResult {
    target: ctx.target,
    ok: true,
    message: f"{ctx.target.xib_path}: converted",
    diags: [],
  }
}

// ---------------------------------------------------------------------------
// Orchestration
// ---------------------------------------------------------------------------

// convert runs ResolveProjectPaths once, then fans out one concurrent
// worker per target via task {}, then fans in every TargetResult over a
// single Channel before reporting a batch summary. One target failing does
// not stop or affect any other target's worker.
pub fn convert(cfg: ConvertConfig) -> Result<ConvertResult, error> {
  let paths_result = run_resolve_project_paths(&cfg)?
  if has_error(paths_result.diags) {
    let n = error_count(paths_result.diags)
    return Ok(
      ConvertResult {
        ok: false,
        message: paths_halt_message(n, paths_result.diags),
        diags: paths_result.diags,
      },
    )
  }

  let targets = paths_result.targets
  let results_ch = Channel.new<TargetResult>()
  for target in targets {
    task {
      results_ch.send(run_target(target, cfg))
    }
  }

  let mut results: Slice<TargetResult> = []
  let mut received = 0
  while received < targets.length() {
    if let Some(r) = results_ch.receive() { results = results.append(r) }
    received += 1
  }

  let mut failed = 0
  let mut all_diags: Slice<Diagnostic> = []
  for r in results {
    if !r.ok { failed += 1 }
    for d in r.diags {
      all_diags = all_diags.append(d)
    }
  }
  let succeeded = results.length() - failed

  Ok(
    ConvertResult {
      ok: failed == 0,
      message: f"convert complete: {succeeded}/{targets.length()} target(s) succeeded",
      diags: all_diags,
    },
  )
}

// paths_halt_message renders a ResolveProjectPaths halt with concrete Error
// diagnostics. Separate from any per-target message: this only fires before
// any target worker starts.
fn paths_halt_message(error_total: int, diags: Slice<Diagnostic>) -> string {
  let mut lines: Slice<string> = [
    f"convert halted: {error_total} error(s) in resolve project paths",
  ]
  let mut displayed = 0
  for d in diags {
    if d.level == DiagLevel.Error && displayed < 5 {
      lines = lines.append(f"  {d.message}")
      displayed += 1
    }
  }
  if error_total > displayed {
    lines = lines.append(f"  ... {error_total - displayed} more error(s)")
  }
  strings.Join(lines, "\n")
}
